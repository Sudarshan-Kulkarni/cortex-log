# Neon Serverless PostgreSQL connection string
# If omitted locally, Cortex Log falls back to local SQLite (sqlite:///./cortex_log.db)
DATABASE_URL=postgresql+psycopg://user:password@ep-example.us-east-2.aws.neon.tech/cortex_log?sslmode=require

# Google Gemini API Key (for chunked flashcard extraction)
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Pub/Sub Configuration
# If GCP_PROJECT_ID is omitted locally, Cortex Log falls back to an in-process async message queue
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=
PUBSUB_BLOG_TOPIC=blog-ingestion
PUBSUB_BLOG_SUB=blog-ingestion-sub
PUBSUB_ANKI_TOPIC=anki-delivery
PUBSUB_ANKI_SUB=anki-delivery-sub

# Clerk Authentication (JWT verification)
CLERK_ISSUER_URL=https://your-app.clerk.accounts.dev

# Optional CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3010,http://localhost:3000
